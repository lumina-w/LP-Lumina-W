# Lúmina W — contact form backend env vars.
# Copy to `.env` for local `netlify dev`, and set the same keys in
# Netlify > Site config > Environment variables for production.
# Never commit real values; `.env` is gitignored.

# Supabase (Project Settings > API Keys — use the SECRET key, not publishable)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx           # server-only, bypasses RLS

# Resend (https://resend.com — API Keys)
# FROM must use a verified Resend domain/subdomain. We verified the subdomain
# info.luminaw.co, so the sender lives there. A display name is optional.
RESEND_API_KEY=re_your_api_key
CONTACT_TO=contact@luminaw.co                      # inbox that receives leads
CONTACT_FROM=Lúmina W <no-reply@info.luminaw.co>   # sender on the verified (sub)domain
