# Lúmina W — contact form backend env vars.
# Copy to `.env` for local `netlify dev`, and set the same keys in
# Netlify > Site config > Environment variables for production.
# Never commit real values; `.env` is gitignored.

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, bypasses RLS

# Resend (https://resend.com — API Keys)
RESEND_API_KEY=re_your_api_key
CONTACT_TO=contact@luminaw.co                      # inbox that receives leads
CONTACT_FROM=web@luminaw.co                        # verified Resend sender domain
