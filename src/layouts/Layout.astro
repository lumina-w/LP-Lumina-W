---
import '@/styles/global.css';
import NavBar from '@/components/ui/NavBar.astro';
import Footer from '@/components/ui/Footer.astro';
import CookiesBanner from '@/components/ui/CookiesBanner.astro';
import Loader from '@/components/ui/Loader.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Desarrollo de software a medida en Colombia | Lúmina W',
  description = 'Software a medida, automatizaciones y sistemas digitales para empresas que necesitan operar sin procesos manuales. Desde Medellín para toda Colombia.',
  image = '/brand/og-image.png',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://luminaw.co');
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Lúmina W S.A.S" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es-co" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://luminaw.co${image}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Lúmina W — Desarrollo de software a medida en Colombia"
    />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Lúmina W" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wavival0" />
    <meta name="twitter:creator" content="@wavival0" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://luminaw.co${image}`} />
    <meta
      name="twitter:image:alt"
      content="Lúmina W — Desarrollo de software a medida en Colombia"
    />

    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#1b1f28" />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content="Lúmina W" />
    <meta name="apple-mobile-web-app-title" content="Lúmina W" />

    <link rel="apple-touch-icon" href={`${BASE}brand/logo.webp`} />
    <link rel="icon" href={`${BASE}brand/logo.ico`} />
    <link rel="icon" type="image/webp" href={`${BASE}brand/logo.webp`} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.fontshare.com" />
    <link
      rel="preload"
      as="style"
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,800&f[]=switzer@400,500,600&display=swap"
    />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Google Search Console verificado vía DNS (no requiere meta tag) -->
    <!-- TODO: pegar verification IDs cuando estén disponibles -->
    <!-- <meta name="msvalidate.01" content="PEGAR_AQUI" /> -->
    <!-- <meta name="yandex-verification" content="PEGAR_AQUI" /> -->
    <!-- <meta name="facebook-domain-verification" content="PEGAR_AQUI" /> -->

    <noscript>
      <style>
        .animate-on-scroll {
          opacity: 1 !important;
          transform: none !important;
        }
        .loader {
          display: none !important;
        }
      </style>
    </noscript>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'ProfessionalService',
            '@id': 'https://luminaw.co/#organization',
            name: 'Lúmina W',
            legalName: 'Lúmina W S.A.S',
            url: 'https://luminaw.co',
            logo: {
              '@type': 'ImageObject',
              url: 'https://luminaw.co/brand/logo.webp',
            },
            image: 'https://luminaw.co/brand/og-image.png',
            description:
              'Tu operación no debería depender de Excel. Software a medida y SaaS B2B para empresas que necesitan operar con control, sin procesos manuales.',
            email: 'contact@luminaw.co',
            telephone: '+57-3108283088',
            priceRange: '$$',
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Medellín',
              addressRegion: 'Antioquia',
              addressCountry: 'CO',
            },
            geo: {
              '@type': 'GeoCoordinates',
              latitude: 6.2442,
              longitude: -75.5812,
            },
            areaServed: {
              '@type': 'Country',
              name: 'Colombia',
            },
            contactPoint: {
              '@type': 'ContactPoint',
              telephone: '+57-3108283088',
              contactType: 'customer service',
              email: 'contact@luminaw.co',
              url: 'https://wa.me/573108283088',
              availableLanguage: ['Spanish', 'es-CO'],
              areaServed: 'CO',
            },
            sameAs: [
              'https://instagram.com/luminaw.co',
              'https://linkedin.com/company/lumina-w',
              'https://x.com/wavival0',
              'https://blog.luminaw.co',
            ],
          },
          {
            '@type': 'WebSite',
            '@id': 'https://luminaw.co/#website',
            url: 'https://luminaw.co',
            name: 'Lúmina W',
            description:
              'Desarrollo de software a medida, automatizaciones y sistemas digitales para empresas en Colombia.',
            publisher: { '@id': 'https://luminaw.co/#organization' },
            inLanguage: 'es-CO',
          },
          {
            '@type': 'WebPage',
            '@id': `${canonicalURL.toString()}#webpage`,
            url: canonicalURL.toString(),
            name: title,
            description: description,
            isPartOf: { '@id': 'https://luminaw.co/#website' },
            inLanguage: 'es-CO',
          },
        ],
      })}
    />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-[var(--brand-dark)] focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Loader />
    <NavBar />
    <main id="main-content" class="with-nav">
      <slot />
    </main>
    <Footer />
    <CookiesBanner />
    <a
      href="https://wa.me/573108283088"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class="wa-fab"
    >
      <Icon name="whatsapp" size={28} stroke={2} />
    </a>
    <div id="cursor-glow" aria-hidden="true"></div>
    <script>
      import '@/scripts/nav.ts';
    </script>
    <script>
      import '@/scripts/cursor.ts';
    </script>
    <script>
      import '@/scripts/scrollAnimations.ts';
    </script>
  </body>
</html>
