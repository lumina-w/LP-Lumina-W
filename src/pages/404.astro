---
import Layout from '@/layouts/Layout.astro';
import { useTranslations } from '@/i18n/utils';

const base = import.meta.env.BASE_URL;
const dict = useTranslations(Astro.currentLocale);
const t = dict.notFound;
---

<Layout title={dict.meta.notFoundTitle}>
  <div
    class="bg-page flex min-h-[calc(100vh-64px)] flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <p class="font-display text-brand text-8xl font-bold">404</p>

    <div class="flex flex-col gap-2">
      <h1 class="font-display text-dark text-2xl font-bold">
        {t.heading}
      </h1>
      <p class="text-dark text-sm">
        {t.text}
      </p>
    </div>
    <a href={base} class="btn-secondary mt-3">{t.back}</a>
  </div>
</Layout>
