---
const BASE = import.meta.env.BASE_URL;
---

<div
  id="cookie-banner"
  class="bg-dark border-light/10 shadow-base fixed right-6 bottom-6 left-6 z-[90] flex hidden flex-col gap-4 rounded-lg border p-6 md:right-6 md:left-auto md:max-w-sm"
>
  <div class="flex flex-col gap-2">
    <p class="font-heading text-light text-sm font-semibold">
      Usamos cookies 🍪
    </p>
    <p class="font-body text-light/80 text-xs leading-relaxed">
      Usamos cookies de análisis para mejorar tu experiencia. Puedes aceptarlas
      o rechazarlas.
      <a href="/cookies" class="text-light hover:text-brand underline"
        >Más información sobre cookies</a
      >
    </p>
  </div>

  <div class="flex gap-3">
    <button
      id="cookie-accept"
      class="btn-primary flex-1 justify-center py-2 text-xs"
    >
      Aceptar
    </button>
    <button
      id="cookie-reject"
      class="border-light/20 font-body text-light/60 hover:border-light/40 flex-1 cursor-pointer rounded-md border px-4 py-2 text-xs font-semibold transition-colors duration-200"
    >
      Rechazar
    </button>
  </div>
</div>

<script>
  import '@/scripts/cookies.ts';
</script>
