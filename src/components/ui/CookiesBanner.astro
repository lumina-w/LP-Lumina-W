---
import { useTranslations, localizePath } from '@/i18n/utils';
const BASE = import.meta.env.BASE_URL;
const loc = Astro.currentLocale;
const t = useTranslations(loc).cookies;
---

<div
  id="cookie-banner"
  role="region"
  aria-label={t.regionAria}
  class="shadow-base border-dark/20 fixed right-6 bottom-6 left-6 z-[90] flex hidden flex-col gap-3 rounded-lg border p-4 outline-none md:right-auto md:left-6 md:max-w-xs"
  style="background-color: #ffffff"
>
  <p class="font-body text-dark text-xs leading-relaxed">
    {t.textPre}
    <a
      href={localizePath('/cookies', loc)}
      class="hover:text-brand text-[#2a5fd6] underline">{t.moreLink}</a
    >
  </p>

  <div class="flex gap-2">
    <button
      id="cookie-accept"
      class="btn-primary flex-1 justify-center py-2 text-xs"
    >
      {t.accept}
    </button>
    <button
      id="cookie-reject"
      class="border-dark/30 font-body text-dark hover:border-dark/60 flex-1 cursor-pointer rounded-md border px-3 py-2 text-xs font-semibold transition-colors duration-200"
    >
      {t.reject}
    </button>
  </div>
</div>

<script>
  import '@/scripts/cookies.ts';
</script>
