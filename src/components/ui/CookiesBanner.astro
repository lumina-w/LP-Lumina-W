---
const BASE = import.meta.env.BASE_URL;
---

<div 
  id="cookie-banner"
  class="hidden fixed bottom-6 left-6 right-6 md:left-auto md:right-6 md:max-w-sm z-[90] bg-dark border border-light/10 rounded-lg p-6 shadow-base flex flex-col gap-4"
>
  <div class="flex flex-col gap-2">
    <p class="font-heading font-semibold text-sm text-light">
      Usamos cookies 🍪
    </p>
    <p class="font-body text-xs text-light/50 leading-relaxed">
      Usamos cookies de análisis para mejorar tu experiencia. 
      Puedes aceptarlas o rechazarlas. 
      <a href="/cookies" class="text-brand hover:underline">Más información</a>
    </p>
  </div>

  <div class="flex gap-3">
    <button 
      id="cookie-accept"
      class="btn-primary flex-1 justify-center text-xs py-2"
    >
      Aceptar
    </button>
    <button 
      id="cookie-reject"
      class="flex-1 px-4 py-2 rounded-md border border-light/20 font-body text-xs font-semibold text-light/60 hover:border-light/40 transition-colors duration-200 cursor-pointer"
    >
      Rechazar
    </button>
  </div>
</div>

<script>
  import '@/scripts/cookies.ts';
</script>