---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n/utils';

const BASE = import.meta.env.BASE_URL;
const t = useTranslations(Astro.currentLocale).nav;
const products = t.products;
---

<header id="nav" class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/" aria-label={t.brandAria}>
      <img
        src={`${BASE}brand/logo.webp`}
        alt=""
        width="26"
        height="26"
        decoding="async"
      />
      <span class="nav__wordmark">Lúmina W</span>
    </a>
    <nav class="nav__links" aria-label={t.primaryAria}>
      <a class="nav__link" href="/#services">{t.services}</a>
      <a class="nav__link" href="/#process">{t.process}</a>
      <a class="nav__link" href="/#us">{t.us}</a>
      {
        products.map((it) => (
          <a
            class="nav__link nav__link--ext"
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener noreferrer' : undefined}
          >
            {it.label}
            {it.badge && <span class="nav__badge">{it.badge}</span>}
            {it.external && (
              <span class="sr-only"> (abre en una pestaña nueva)</span>
            )}
            <Icon
              name="external"
              size={13}
              stroke={1.75}
              class="nav__ext-icon"
            />
          </a>
        ))
      }
    </nav>
    <div class="nav__cta">
      <a
        class="btn-primary"
        href="/#contact"
        style="padding:8px 14px;font-size:13.5px"
      >
        {t.cta}
      </a>
      <button
        id="nav-burger"
        class="nav__burger"
        aria-label={t.openMenu}
        aria-expanded="false"
      >
        <Icon name="menu" size={22} stroke={1.75} />
      </button>
    </div>
  </div>
</header>

<div id="nav-mobile" class="nav__mobile" aria-hidden="true">
  <a class="nav__mobile-link" href="/#services">{t.services}</a>
  <a class="nav__mobile-link" href="/#process">{t.process}</a>
  <a class="nav__mobile-link" href="/#us">{t.us}</a>
  {
    products.map((it) => (
      <a
        class="nav__mobile-link nav__mobile-link--ext"
        href={it.href}
        target={it.external ? '_blank' : undefined}
        rel={it.external ? 'noopener noreferrer' : undefined}
      >
        {it.label}
        {it.badge && <span class="nav__badge">{it.badge}</span>}
        {it.external && (
          <span class="sr-only"> (abre en una pestaña nueva)</span>
        )}
        <Icon name="external" size={14} stroke={1.75} class="nav__ext-icon" />
      </a>
    ))
  }
  <a class="nav__mobile-link" href="/#contact">{t.contact}</a>
</div>
