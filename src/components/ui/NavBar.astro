---
import Button from '@/components/ui/Button.astro';
import Link from '@/components/ui/Link.astro';

const BASE = import.meta.env.BASE_URL;
---

<header
  id="navbar"
  class="fixed top-0 right-0 left-0 z-50 transition-all duration-300"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <Link href="/">
      <span>
        <img
          src={`${BASE}brand/logo.webp`}
          alt="Lúmina W"
          class="h-12 w-auto"
        />
      </span>
    </Link>

    <ul class="hidden list-none items-center gap-8 md:flex">
      <li><Link href="/#hero">Inicio</Link></li>
      <li><Link href="/#services">Servicios</Link></li>
      <li><Link href="/#terracore">TerraCore</Link></li>
      <li><Link href="/#us">Nosotros</Link></li>
      <li><Link href="https://blog.luminaw.co/" target="_blank">Blog</Link></li>
    </ul>
    <div class="hidden md:flex">
      <Button href="/#contact" icon="send-form-white">Agenda llamada</Button>
    </div>
    <div class="md:hidden">
      <button id="menu-btn" class="cursor-pointer p-2" aria-label="Abrir menú">
        <img
          id="icon-open"
          src={`${BASE}icons/ui/open-menu.svg`}
          class="h-6 w-6"
          alt="Abrir menú"
        />
        <img
          id="icon-close"
          src={`${BASE}icons/ui/close.svg`}
          class="hidden h-6 w-6"
          alt="Cerrar menú"
        />
      </button>
    </div>
  </nav>
</header>
<div
  id="mobile-menu"
  class="bg-page pointer-events-none fixed inset-0 z-40 flex translate-y-2 flex-col items-start gap-8 border-t border-[var(--border-base)] px-10 py-10 opacity-0 transition-all duration-300 ease-in-out md:hidden"
  style="top: 64px;"
>
  <Link href="/#hero" class="!text-base">Inicio</Link>
  <Link href="/#services" class="!text-base">Servicios</Link>
  <Link href="/#terracore" class="!text-base">TerraCore</Link>
  <Link href="/#us" class="!text-base">Nosotros</Link>
  <Link href="/#contact" class="!text-base">Contacto</Link>
  <Button href="https://blog.luminaw.co/" class="!text-base" type="button" target="_blank" icon="read-more-white">Blog</Button>
</div>
<div class="h-16"></div>
<script>
  import '@/scripts/nav.ts';
</script>
