---
import Icon from '@/components/ui/Icon.astro';

const BASE = import.meta.env.BASE_URL;
const LOGO = `${BASE}brand/logo.webp`;
const year = new Date().getFullYear();
---

<footer class="footer surface-dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__mark" href="/#hero" aria-label="Lúmina W, Inicio">
          <img src={LOGO} alt="" width="28" height="28" decoding="async" />
          <span>Lúmina W</span>
        </a>
        <p class="footer__legalname">Lúmina W S.A.S</p>
        <p class="footer__copy">Creamos software. Los negocios lo rentan.</p>
        <p class="footer__copy" style="font-size:12px;color:#6b7280">
          Desarrollado por
          <a
            href="https://wavival.dev"
            target="_blank"
            rel="noopener noreferrer"
            style="color:#a1a5ad;font-style:italic">@wavival</a
          >
        </p>
        <div class="footer__social">
          <a
            href="https://instagram.com/luminaw.co"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <Icon name="instagram" size={18} stroke={2} />
          </a>
          <a
            href="https://linkedin.com/company/lumina-w"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" size={18} stroke={2} />
          </a>
          <a
            href="https://wa.me/573108283088"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
          >
            <Icon name="whatsapp" size={18} stroke={2} />
          </a>
        </div>
      </div>

      <div class="footer__col">
        <h4>Empresa</h4>
        <ul>
          <li><a href="/#hero">Inicio</a></li>
          <li><a href="/#problem">Problema</a></li>
          <li><a href="/#services">Servicios</a></li>
          <li><a href="/#process">Proceso</a></li>
          <li><a href="/#terracore">TerraCore</a></li>
          <li><a href="/#us">Nosotros</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/#contact">Contacto</a></li>
          <li>
            <a
              href="https://blog.luminaw.co/"
              target="_blank"
              rel="noopener noreferrer">Blog</a
            >
          </li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Servicios</h4>
        <ul>
          <li><a href="/#services">Desarrollo a medida</a></li>
          <li><a href="/#services">SaaS B2B</a></li>
          <li><a href="/#terracore">TerraCore</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/terms">Términos y condiciones</a></li>
          <li><a href="/privacy">Política de privacidad</a></li>
          <li><a href="/cookies">Política de cookies</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© Lúmina W S.A.S {year}</span>
      <span>contact@luminaw.co</span>
    </div>
  </div>
</footer>
