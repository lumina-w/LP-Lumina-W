---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, localizePath } from '@/i18n/utils';

const BASE = import.meta.env.BASE_URL;
const LOGO = `${BASE}brand/logo.webp`;
const year = new Date().getFullYear();
const loc = Astro.currentLocale;
const t = useTranslations(loc).footer;
const lp = (p: string) => localizePath(p, loc);
---

<footer class="footer surface-dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__mark" href={lp('/#hero')} aria-label={t.brandAria}>
          <img src={LOGO} alt="" width="28" height="28" decoding="async" />
          <span>Lúmina W</span>
        </a>
        <p class="footer__legalname">{t.legalName}</p>
        <p class="footer__copy">
          {t.copy}
        </p>
        <div class="footer__social">
          <a
            href="https://instagram.com/luminaw.co"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Instagram${t.opensNewTab}`}
          >
            <Icon name="instagram" size={18} stroke={2} />
          </a>
          <a
            href="https://linkedin.com/company/lumina-w"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`LinkedIn${t.opensNewTab}`}
          >
            <Icon name="linkedin" size={18} stroke={2} />
          </a>
          <a
            href="https://wa.me/573108283088"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`WhatsApp${t.opensNewTab}`}
          >
            <Icon name="whatsapp" size={18} stroke={2} />
          </a>
        </div>
      </div>

      <div class="footer__col">
        <h4>{t.navTitle}</h4>
        <ul>
          {
            t.nav.map((it) => (
              <li>
                <a href={lp(it.href)}>{it.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h4>{t.productTitle}</h4>
        <ul>
          {
            t.product.map((it) => (
              <li>
                <a
                  href={it.external ? it.href : lp(it.href)}
                  target={it.external ? '_blank' : undefined}
                  rel={it.external ? 'noopener noreferrer' : undefined}
                >
                  {it.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h4>{t.legalTitle}</h4>
        <ul>
          {
            t.legal.map((it) => (
              <li>
                <a href={lp(it.href)}>{it.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© Lúmina W S.A.S {year}</span>
    </div>
  </div>
</footer>
