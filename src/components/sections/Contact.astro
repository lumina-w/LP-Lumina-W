---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, anchorId } from '@/i18n/utils';
const loc = Astro.currentLocale;
const t = useTranslations(loc).contact;
---

<section class="section surface-dark" id={anchorId('contact', loc)}>
  <div class="animate-on-scroll container">
    <div class="contact">
      <div class="contact__copy">
        <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
        <div class="eyebrow" style="color:var(--text-on-dark-muted)">
          {t.eyebrow}
        </div>
        <h2 style="color:#fff;margin-top:20px">
          {t.heading}
        </h2>
        <p
          class="lead"
          style="margin-top:14px;max-width:42ch;color:var(--text-on-dark-muted)"
        >
          {t.lead}
        </p>
        <div class="contact__direct">{t.direct}</div>
        <div class="contact__channels">
          <a
            class="contact__channel"
            href="https://wa.me/573108283088"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" size={20} stroke={2} />
            <div>
              <div class="contact__channel-label">{t.whatsappLabel}</div>
              <div class="contact__channel-value">{t.whatsappValue}</div>
              <div class="contact__channel-note">
                {t.whatsappNote}
              </div>
            </div>
            <span class="sr-only">{t.opensNewTab}</span>
          </a>
          <a class="contact__channel" href="mailto:contact@luminaw.co">
            <Icon name="mail" size={20} stroke={1.75} />
            <div>
              <div class="contact__channel-label">{t.emailLabel}</div>
              <div class="contact__channel-value">{t.emailValue}</div>
              <div class="contact__channel-note">
                {t.emailNote}
              </div>
            </div>
          </a>
        </div>

        <div class="contact__next">
          <div class="contact__next-title">{t.nextTitle}</div>
          <ol class="contact__steps">
            {
              t.steps.map((step, i) => (
                <li class="contact__step">
                  <span class="contact__step-num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="contact__step-text">{step}</span>
                </li>
              ))
            }
          </ol>
          <p class="contact__next-foot">{t.nextFoot}</p>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          class="contact__form"
          data-sending={t.submitSending}
          data-error={t.submitError}
        >
          {/* Honeypot anti-spam: oculto para humanos, los bots lo rellenan */}
          <div class="contact__hp" aria-hidden="true">
            <label for="c-website">No llenar este campo</label>
            <input
              id="c-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <div class="contact__row">
            <div class="contact__field">
              <label for="c-name"
                >{t.fieldName}<span class="req" aria-hidden="true">*</span
                ></label
              >
              <input
                id="c-name"
                name="name"
                type="text"
                placeholder={t.fieldNamePh}
                required
              />
            </div>
            <div class="contact__field">
              <label for="c-company"
                >{t.fieldCompany}<span class="req" aria-hidden="true">*</span
                ></label
              >
              <input
                id="c-company"
                name="company"
                type="text"
                placeholder={t.fieldCompanyPh}
                required
              />
            </div>
          </div>
          <div class="contact__row">
            <div class="contact__field">
              <label for="c-email"
                >{t.fieldEmail}<span class="req" aria-hidden="true">*</span
                ></label
              >
              <input
                id="c-email"
                name="email"
                type="email"
                placeholder={t.fieldEmailPh}
                required
              />
            </div>
            <div class="contact__field">
              <label for="c-phone"
                >{t.fieldPhone}<span class="req" aria-hidden="true">*</span
                ></label
              >
              <input
                id="c-phone"
                name="phone"
                type="tel"
                placeholder={t.fieldPhonePh}
                required
              />
            </div>
          </div>
          <fieldset class="contact__choices">
            <legend
              >{t.needLegend}<span class="req" aria-hidden="true">*</span
              ></legend
            >
            {
              t.needOptions.map((opt, i) => (
                <label class="contact__choice">
                  <input
                    type="radio"
                    name="need"
                    value={opt}
                    required={i === 0 ? true : undefined}
                  />
                  <span>{opt}</span>
                </label>
              ))
            }
          </fieldset>
          <fieldset class="contact__choices">
            <legend
              >{t.stageLegend}<span class="req" aria-hidden="true">*</span
              ></legend
            >
            {
              t.stageOptions.map((opt, i) => (
                <label class="contact__choice">
                  <input
                    type="radio"
                    name="stage"
                    value={opt}
                    required={i === 0 ? true : undefined}
                  />
                  <span>{opt}</span>
                </label>
              ))
            }
          </fieldset>
          <div class="contact__field">
            <label for="c-message"
              >{t.fieldMessage}<span class="req" aria-hidden="true">*</span
              ></label
            >
            <textarea
              id="c-message"
              name="message"
              rows="4"
              placeholder={t.fieldMessagePh}
              required></textarea>
          </div>
          <button id="submit-btn" type="submit" class="btn-primary">
            {t.submit}
          </button>
          <p id="form-error" class="contact__error" role="alert" hidden></p>
          <ul class="contact__assurances">
            {t.assurances.map((a) => <li>{a}</li>)}
          </ul>
        </form>
        <div
          id="form-success"
          class="contact__success"
          role="status"
          tabindex="-1"
        >
          <h3>{t.successTitle}</h3>
          <p>{t.successText}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '@/scripts/contact.ts';
</script>
