---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, localizePath, anchorId } from '@/i18n/utils';
const loc = Astro.currentLocale;
const t = useTranslations(loc).solution;
const services = t.services;
const lp = (p: string) => localizePath(p, loc);
---

<section class="section" id={anchorId('services', loc)}>
  <div class="animate-on-scroll container">
    <div class="s-head s-head--stack">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.leadA}
        <br /><br />
        {t.leadBPre}
        <strong>{t.leadBStrongA}</strong>{t.leadBMid}<strong
          >{t.leadBStrongB}</strong
        >{t.leadBPost}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>

    <div class="services">
      {
        services.map((s) => (
          <div
            class={`service ${s.inverse ? 'service--inverse' : ''} ${s.primary ? 'service--primary' : 'service--compact'}`}
          >
            {s.primary && <div class="service__flag">{t.flag}</div>}
            <div class="service__head">
              <div class="service__tag">{s.tag}</div>
              <div class="service__icon">
                <Icon name={s.icon} size={32} stroke={1.5} />
              </div>
            </div>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <ul class="service__list">
              {s.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a
              class="service__cta"
              href={s.ctaExternal ? s.ctaHref : lp(s.ctaHref)}
              target={s.ctaExternal ? '_blank' : undefined}
              rel={s.ctaExternal ? 'noopener noreferrer' : undefined}
            >
              {s.ctaLabel}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
