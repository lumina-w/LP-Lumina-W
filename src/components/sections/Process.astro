---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(Astro.currentLocale).process;
const tracks = t.tracks;
const portalCustom = t.portalCustom;
const portalSaas = t.portalSaas;
---

<section class="section process-sec" id="process">
  <div class="animate-on-scroll container">
    <div class="s-head s-head--stack">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.lead}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>

    <p class="process-hook">
      {t.hook}
    </p>

    {
      tracks.map((track) => (
        <div class="process-track">
          <header class="process-track__head">
            <span class="process-track__tag">{track.tag}</span>
            <h3>{track.title}</h3>
            <p>{track.lead}</p>
          </header>
          <details class="process-track__detail">
            <summary class="disclosure">
              <span class="lbl-closed">{t.disclosureOpenLabel}</span>
              <span class="lbl-open">{t.disclosureCloseLabel}</span>
              <Icon name="plus" size={20} stroke={1.75} />
            </summary>
            <div class="features">
              {track.phases.map((p) => (
                <div class="feature">
                  <div class="feature__num">{p.n}</div>
                  <div class="feature__head">
                    <div class="feature__icon">
                      <Icon name={p.icon} size={26} stroke={1.5} />
                    </div>
                    <h3>{p.title}</h3>
                  </div>
                  <p>{p.body}</p>
                </div>
              ))}
            </div>
          </details>
        </div>
      ))
    }

    <div class="portal portal--split">
      <header class="portal__head portal__head--full">
        <span class="portal__label">{t.portalLabel}</span>
        <h3>{t.portalHeading}</h3>
        <p>
          {t.portalText}
        </p>
      </header>

      <details class="portal__detail">
        <summary class="disclosure">
          <span class="lbl-closed">{t.portalDisclosureOpenLabel}</span>
          <span class="lbl-open">{t.portalDisclosureCloseLabel}</span>
          <Icon name="plus" size={20} stroke={1.75} />
        </summary>
        <div class="portal__cols">
          <div class="portal__col">
            <h4 class="portal__col-title">{t.portalCustomTitle}</h4>
            <p class="portal__col-sub">{t.portalCustomSub}</p>
            <p class="portal__col-text">
              {t.portalCustomText}
            </p>
            <ul class="portal__list">
              {portalCustom.map((it) => <li>{it}</li>)}
            </ul>
          </div>

          <div class="portal__col">
            <h4 class="portal__col-title">{t.portalSaasTitle}</h4>
            <p class="portal__col-sub">
              {t.portalSaasSub}
            </p>
            <p class="portal__col-text">
              {t.portalSaasText}
            </p>
            <ul class="portal__list">
              {portalSaas.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        </div>
      </details>
    </div>

    <div style="margin-top:48px;text-align:center">
      <p style="font-size:14px;color:var(--text-muted);margin-bottom:14px">
        {t.ctaKicker}
      </p>
      <a class="btn-primary" href="#contact">{t.cta}</a>
    </div>
  </div>
</section>
