---
import { useTranslations } from '@/i18n/utils';
const items = useTranslations(Astro.currentLocale).marquee;
const doubled = [...items, ...items];
---

<div class="marquee animate-on-scroll" aria-hidden="true">
  <div class="marquee__track">
    {doubled.map((it) => <span class="marquee__item">{it}</span>)}
  </div>
</div>
