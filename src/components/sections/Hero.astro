<section class="hero" id="hero">
  <div class="container section hero__grid animate-on-scroll">
    <div class="ghost-num hero__ghost-num" aria-hidden="true">01</div>
    <div class="hero__copy">
      <div class="eyebrow">Software &amp; Technology</div>
      <h1>
        Creamos software.<br />
        Los negocios <em>lo rentan</em>.
      </h1>
      <p class="hero__lead">
        Tu operación tiene problemas que Excel no puede resolver.<br />
        Nosotros sí.
      </p>
      <div class="hero__actions">
        <a class="btn-primary" href="/#contact">Agenda una llamada</a>
        <a class="btn-secondary" href="/#terracore">Ver TerraCore</a>
      </div>
    </div>

    <div class="hero__geo">
      <svg viewBox="0 0 460 460" aria-hidden="true">
        <defs>
          <linearGradient id="hero-stack" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#407bff"></stop>
            <stop offset="100%" stop-color="#1b4ebf"></stop>
          </linearGradient>
        </defs>

        <g stroke="#e6e6e8" stroke-width="1">
