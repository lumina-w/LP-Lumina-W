---
import { useTranslations, localizePath, anchorId } from '@/i18n/utils';
const loc = Astro.currentLocale;
const t = useTranslations(loc).hero;
const lp = (p: string) => localizePath(p, loc);
---

<section class="hero hero--center" id={anchorId('hero', loc)}>
  <div class="section hero__inner animate-on-scroll container">
    <div class="eyebrow">{t.eyebrow}</div>

    <h1>
      {t.titleA}<br />
      {t.titlePre}<em>{t.titleEm}</em>{t.titlePost}
    </h1>

    <p class="hero__lead">
      {t.lead}
    </p>

    <div class="hero__actions">
      <a class="btn-primary" href={lp('/#contact')}>{t.ctaPrimary}</a>
      <a class="btn-secondary" href={lp('/#terracore')}>{t.ctaSecondary}</a>
    </div>

    <ul class="hero__caps" aria-label={t.capsAria}>
      {
        t.caps.map((cap) => (
          <li class="hero__cap">
            <span class="hero__cap-title">{cap.title}</span>
            <span class="hero__cap-desc">{cap.desc}</span>
          </li>
        ))
      }
    </ul>

    <div class="hero-term" role="img" aria-label={t.termAria}>
      <div class="hero-term__bar" aria-hidden="true">
        <span class="hero-term__dot"></span>
        <span class="hero-term__dot"></span>
        <span class="hero-term__dot"></span>
      </div>
      <ul class="hero-term__rows" aria-hidden="true">
        {
          t.termRows.map((row) => (
            <li class="hero-term__row">
              <span class="hero-term__check">✓</span>
              <span class="hero-term__label">{row.label}</span>
              <span
                class={`hero-term__val ${row.num ? 'hero-term__val--num' : ''}`}
              >
                {row.val}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="hero-term__foot" aria-hidden="true">
        {t.termFoot}
      </p>
    </div>
  </div>
</section>
