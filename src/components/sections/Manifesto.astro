---
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(Astro.currentLocale).manifesto;
---

<section class="manifesto">
  <div class="animate-on-scroll container">
    <div class="manifesto__inner">
      <div class="manifesto__mark">
        <b>“</b>
        {t.markLine && <span set:html={t.markLine.replace('\n', '<br />')} />}
      </div>
      <div>
        <p class="manifesto__quote">
          {t.quoteA}<br />
          {t.quoteBPre}<em>{t.quoteEm}</em>{t.quoteBPost}<br />
          {t.quoteEnd}
        </p>
        <p class="manifesto__attribution">{t.attribution}</p>
      </div>
    </div>
  </div>
</section>
