---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, anchorId } from '@/i18n/utils';
const loc = Astro.currentLocale;
const t = useTranslations(loc).problem;
const problems = t.items;
---

<section class="section" id={anchorId('problem', loc)}>
  <div class="animate-on-scroll container">
    <div class="s-head">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.lead}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>
    <div class="features">
      {
        problems.map((p) => (
          <div class="feature">
            <div class="feature__num">{p.n}</div>
            <div class="feature__head">
              <div class="feature__icon">
                <Icon name={p.icon} size={26} stroke={1.5} />
              </div>
              <h3>{p.title}</h3>
            </div>
            <p>{p.description}</p>
          </div>
        ))
      }
    </div>
    <div class="stakes">
      <p class="stakes__kicker">{t.stakesKicker}</p>
      <p class="stakes__line">
        {t.stakesLinePre}<em>{t.stakesLineEm}</em>{t.stakesLinePost}
      </p>
    </div>
  </div>
</section>
