---
const modules = [
  { name: 'Control de animales.', icon: 'layer' },
  { name: 'Producción en tiempo real.', icon: 'chart' },
  { name: 'Control de insumos.', icon: 'layer' },
  { name: 'Dashboard claro y centralizado.', icon: 'chart' },
  { name: 'Salud animal.', icon: 'layer' },
  { name: 'Control básico de costos.', icon: 'chart' },
];
---

<section id="terracore" class="bg-page py-(--space-section)">
  <div class="animate-on-scroll mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-1 items-center gap-16">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <span
              class="font-body text-brand text-xs font-semibold tracking-widest uppercase"
            >
              Producto estrella
            </span>
            <span
              class="border-brand/20 font-body text-brand rounded-full border bg-[var(--bg-blur)] px-2 py-1 text-xs"
            >
              Preventa activa
            </span>
          </div>
          <h2
            class="font-heading text-text-primary text-4xl leading-tight font-bold md:text-5xl"
          >
            TerraCore
          </h2>
          <p class="font-body text-text-muted text-lg leading-relaxed">
            El sistema de gestión que el sector agroindustrial necesitaba.
            Construido para medianas empresas que necesitan dejar de operar en
            Excel y empezar a tomar decisiones con datos reales.
          </p>
        </div>

        <div class="relative flex items-center justify-center">
          <section class="hero-video">
            <video
              src="/videos/terracore.mp4"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="/images/preview.png"
              class="rounded-md border border-(--border-base)]"
            ></video>
          </section>
        </div>

        <div class="flex flex-col gap-3">
          <p
            class="font-body text-text-primary text-sm font-semibold tracking-widest uppercase"
          >
            Módulos MVP
          </p>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {
              modules.map((module) => (
                <div class="bg-card hover:border-brand flex items-center gap-3 rounded-md border border-(--border-base)] p-4 transition-all duration-300">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-(--bg-blur)">
                    <img
                      src={`/icons/isometrics/${module.icon}.webp`}
                      alt="Icono de ${module.name.toLowerCase()} en TerraCore software de gestión agroindustrial"
                      class="h-8 w-8"
                    />
                  </div>
                  <span class="font-body text-text-primary text-sm">
                    {module.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <a href="#contact" class="btn-primary w-fit">
            Quiero ser de los primeros
          </a>
          <p class="font-body text-text-muted text-xs">
            Estamos validando con los primeros clientes. Cupos limitados con
            condiciones especiales.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>