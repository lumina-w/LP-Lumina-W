---
import { useTranslations, localizePath, anchorId } from '@/i18n/utils';
const loc = Astro.currentLocale;
const t = useTranslations(loc).terracore;
const shots = t.shots;
const lp = (p: string) => localizePath(p, loc);
---

<section class="section terracore" id={anchorId('terracore', loc)}>
  <div class="animate-on-scroll container">
    <div class="s-head s-head--stack">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.lead}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>

    <div class="terracore__min">
      <div class="terracore__tags">
        <span class="terracore__tag">{t.tagStar}</span>
        <span class="terracore__tag terracore__tag--live">
          <span></span>{t.tagLive}
        </span>
      </div>
      <h3 class="terracore__name">{t.name}</h3>
      <p class="terracore__lead">
        {t.productLead}
      </p>
    </div>

    <div class="terracore__shots">
      {
        shots.map((s) => (
          <figure class="tc-shot">
            <img
              src={`/images/terracore/${s.base}-1280.webp`}
              srcset={`/images/terracore/${s.base}-1280.webp 1280w, /images/terracore/${s.base}-2240.webp 2240w`}
              sizes="(min-width: 880px) 33vw, 100vw"
              width="2240"
              height="1287"
              loading="lazy"
              decoding="async"
              alt={s.alt}
            />
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="terracore__actions terracore__actions--center">
      <a class="btn-primary" href={lp('/productos')}>
        {t.ctaAll}
      </a>
    </div>
  </div>
</section>
