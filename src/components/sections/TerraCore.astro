---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(Astro.currentLocale).terracore;
const modules = t.modules;
const dashFeatures = t.dashFeatures;
const shots = t.shots;
---

<section class="section terracore" id="terracore">
  <div class="animate-on-scroll container">
    <div class="s-head s-head--stack">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.lead}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>

    <div class="terracore__grid">
      <div class="terracore__copy">
        <div class="terracore__tags">
          <span class="terracore__tag">{t.tagStar}</span>
          <span class="terracore__tag terracore__tag--live">
            <span></span>{t.tagLive}
          </span>
        </div>
        <h3 class="terracore__name">{t.name}</h3>
        <p class="terracore__lead">
          {t.productLead}
        </p>
        <div class="terracore__modules">
          <div class="terracore__modules-head">{t.modulesHead}</div>
          <ul>
            {modules.map((m) => <li>{m}</li>)}
          </ul>
        </div>
        <div class="terracore__actions">
          <a
            class="btn-primary"
            href="https://terracoreapp.co"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.cta}
          </a>
        </div>
        <p class="terracore__note">
          {t.note}
        </p>
      </div>

      <div class="terracore__visual" aria-hidden="true">
        <div class="tc-dash">
          <div class="tc-dash__bar">
            <div class="tc-dash__bar-l">
              <span></span><strong>{t.name}</strong> · {t.dashTagline}
            </div>
            <div>{t.dashYear}</div>
          </div>
          <div class="tc-dash__body">
            <div class="tc-dash__kpis">
              {
                t.dashKpis.map((k) => (
                  <div class="tc-dash__kpi">
                    <div class="tc-dash__kpi-label">{k.label}</div>
                    <div class="tc-dash__kpi-val">{k.val}</div>
                    <div class="tc-dash__kpi-trend">{k.trend}</div>
                  </div>
                ))
              }
            </div>
            <div class="tc-dash__feats">
              <div class="tc-dash__feats-head">
                <span>{t.dashFeatsHead}</span>
                <span>{t.dashFeatsCount}</span>
              </div>
              <div class="tc-dash__feats-grid">
                {
                  dashFeatures.map((f) => (
                    <div class="tc-dash__feat">
                      <div class="tc-dash__feat-icon">
                        <Icon name={f.icon} size={16} stroke={1.5} />
                      </div>
                      <div class="tc-dash__feat-body">
                        <div class="tc-dash__feat-title">{f.title}</div>
                        <div class="tc-dash__feat-tag">{f.tag}</div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="terracore__proof">
      {t.proof}
    </p>

    <div class="terracore__shots">
      {
        shots.map((s) => (
          <figure class="tc-shot">
            <img
              src={`/images/terracore/${s.base}-1280.webp`}
              srcset={`/images/terracore/${s.base}-1280.webp 1280w, /images/terracore/${s.base}-2240.webp 2240w`}
              sizes="(min-width: 880px) 33vw, 100vw"
              width="2240"
              height="1287"
              loading="lazy"
              decoding="async"
              alt={s.alt}
            />
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
