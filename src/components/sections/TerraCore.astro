---
import Icon from '@/components/ui/Icon.astro';

const modules = [
  'Control de animales.',
  'Producción en tiempo real.',
  'Control de insumos.',
  'Dashboard claro y centralizado.',
  'Salud animal.',
  'Control básico de costos.',
];

const dashFeatures = [
  { icon: 'wifi-off', title: 'Funciona offline', tag: 'sync auto' },
  { icon: 'calendar', title: 'Primera semana', tag: 'sin consultores' },
  { icon: 'users', title: 'Varios roles', tag: 'admin · ops · colab' },
  { icon: 'chart', title: 'Datos reales', tag: 'costo por kg' },
  { icon: 'bell', title: 'Nada se te pasa', tag: 'alertas activas' },
  { icon: 'globe', title: 'En español', tag: 'para el campo' },
];

// Capturas reales del producto (reemplazan el video demo)
const shots = [
  {
    base: 'dashboard-2',
    cap: 'Dashboard claro y centralizado',
    alt: 'Captura del dashboard centralizado de TerraCore con métricas de la operación',
  },
  {
    base: 'produccion-1',
    cap: 'Producción en tiempo real',
    alt: 'Pantalla de producción en tiempo real en TerraCore',
  },
  {
    base: 'salud-animal-3',
    cap: 'Salud animal',
    alt: 'Módulo de salud animal en TerraCore',
  },
];
---

<section class="section terracore" id="terracore">
  <div class="animate-on-scroll container">
    <div class="s-head s-head--stack">
      <div>
        <div class="eyebrow">Producto propio</div>
        <h2>Nuestros productos</h2>
      </div>
      <p class="lead">
        Construimos SaaS B2B con los mismos estándares del desarrollo a medida.
        Empezamos por el campo, pero el roadmap no se detiene ahí.
      </p>
      <div class="ghost-num" aria-hidden="true">Producto</div>
    </div>

    <div class="terracore__grid">
      <div class="terracore__copy">
        <div class="terracore__tags">
          <span class="terracore__tag">Producto estrella</span>
          <span class="terracore__tag terracore__tag--live">
            <span></span>Preventa activa
          </span>
        </div>
        <h3 class="terracore__name">TerraCore</h3>
        <p class="terracore__lead">
          Controla producción, costos y animales en un solo lugar. Deja de
          depender de Excel y empieza a tomar decisiones con datos reales.
        </p>
        <div class="terracore__modules">
          <div class="terracore__modules-head">Módulos MVP</div>
          <ul>
            {modules.map((m) => <li>{m}</li>)}
          </ul>
        </div>
        <div class="terracore__actions">
          <a
            class="btn-primary"
            href="https://terracoreapp.co"
            target="_blank"
            rel="noopener noreferrer"
          >
            Quiero probar TerraCore
          </a>
        </div>
        <p class="terracore__note">
          Estamos validando con los primeros clientes. Cupos limitados con
          condiciones especiales.
        </p>
      </div>

      <div class="terracore__visual" aria-hidden="true">
        <div class="tc-dash">
          <div class="tc-dash__bar">
            <div class="tc-dash__bar-l">
              <span></span><strong>TerraCore</strong> · Campo Inteligente
            </div>
            <div>2026</div>
          </div>
          <div class="tc-dash__body">
            <div class="tc-dash__kpis">
              <div class="tc-dash__kpi">
                <div class="tc-dash__kpi-label">Módulos</div>
                <div class="tc-dash__kpi-val">6</div>
                <div class="tc-dash__kpi-trend">listos en MVP</div>
              </div>
              <div class="tc-dash__kpi">
                <div class="tc-dash__kpi-label">Tu información</div>
                <div class="tc-dash__kpi-val">100%</div>
                <div class="tc-dash__kpi-trend">privada</div>
              </div>
              <div class="tc-dash__kpi">
                <div class="tc-dash__kpi-label">Siempre accesible</div>
                <div class="tc-dash__kpi-val">24/7</div>
                <div class="tc-dash__kpi-trend">multi-dispositivo</div>
              </div>
            </div>
            <div class="tc-dash__feats">
              <div class="tc-dash__feats-head">
                <span>Características Principales</span>
                <span>06 / 06</span>
              </div>
              <div class="tc-dash__feats-grid">
                {
                  dashFeatures.map((f) => (
                    <div class="tc-dash__feat">
                      <div class="tc-dash__feat-icon">
                        <Icon name={f.icon} size={16} stroke={1.5} />
                      </div>
                      <div class="tc-dash__feat-body">
                        <div class="tc-dash__feat-title">{f.title}</div>
                        <div class="tc-dash__feat-tag">{f.tag}</div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="terracore__proof">
      Construimos TerraCore desde cero: offline-first, multiusuario y multirol,
      con dashboards en tiempo real y trazabilidad agroindustrial. Ese es el
      estándar con el que trabajamos.
    </p>

    <div class="terracore__shots">
      {
        shots.map((s) => (
          <figure class="tc-shot">
            <img
              src={`/images/terracore/${s.base}-1280.webp`}
              srcset={`/images/terracore/${s.base}-1280.webp 1280w, /images/terracore/${s.base}-2240.webp 2240w`}
              sizes="(min-width: 880px) 33vw, 100vw"
              width="2240"
              height="1287"
              loading="lazy"
              decoding="async"
              alt={s.alt}
            />
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="terracore__more">
      <div class="terracore__more-head">El roadmap sigue</div>
      <div class="terracore__more-grid">
        <article class="prod-card prod-card--soon" id="root">
          <div class="prod-card__badge">Próximamente</div>
          <h3 class="prod-card__title">Root</h3>
          <p class="prod-card__tagline">Come con confianza.</p>
          <p class="prod-card__desc">
            App de nutrición personalizada para personas con enfermedad celíaca,
            diabetes o intolerancia a la lactosa en Latinoamérica. Escanea
            cualquier etiqueta y obtén un veredicto inmediato según tu perfil.
          </p>
          <ul class="prod-card__feats">
            <li>Escaneo de etiquetas con veredicto al instante</li>
            <li>Diario alimentario que funciona offline</li>
            <li>Recetas que sí puedes comer</li>
            <li>Seguimiento e insights semanales</li>
          </ul>
          <a
            class="prod-card__cta"
            href="https://wavival.dev/root"
            target="_blank"
            rel="noopener noreferrer"
          >
            Saber más sobre Root
          </a>
        </article>
      </div>
    </div>
  </div>
</section>
