---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations, anchorId } from '@/i18n/utils';
// Equipo real — A (prueba social por credibilidad del equipo).
// NO inventar experiencia ni usar fotos de stock (regla E).
// Datos del equipo viven en el diccionario i18n.
const loc = Astro.currentLocale;
const t = useTranslations(loc).whyus;
const team = t.team;
const reasons = t.reasons;
const featured = reasons.find((r) => r.featured);
const supporting = reasons.filter((r) => !r.featured);
---

<section class="section" id={anchorId('us', loc)}>
  <div class="animate-on-scroll container">
    <div class="s-head">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.lead}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>
    {
      featured && (
        <article class="why-feature">
          <div class="why-feature__icon">
            <Icon name={featured.icon} size={40} stroke={1.5} />
          </div>
          <div class="why-feature__body">
            <div class="why-feature__label">{t.featuredLabel}</div>
            <h3>{featured.title}</h3>
            <p>{featured.description}</p>
          </div>
        </article>
      )
    }
    <div class="why why--supporting">
      {
        supporting.map((r) => (
          <div class="why__item">
            <div class="why__head">
              <div class="why__icon">
                <Icon name={r.icon} size={24} stroke={1.5} />
              </div>
              <h3>{r.title}</h3>
            </div>
            <p>{r.description}</p>
          </div>
        ))
      }
    </div>

    <div class="team">
      <div class="team__head">
        <div class="eyebrow">{t.teamEyebrow}</div>
        <h3 class="team__title">{t.teamTitle}</h3>
      </div>
      <div class="team__grid">
        {
          team.map((m) => (
            <article class="team-card">
              <div class="team-card__media">
                {m.photo ? (
                  <img
                    src={m.photo}
                    alt=""
                    width="600"
                    height="600"
                    loading="lazy"
                  />
                ) : (
                  <span aria-hidden="true">{m.initials}</span>
                )}
              </div>
              <div class="team-card__body">
                <div class="team-card__name">
                  {m.name}
                  {m.handle && (
                    <span class="team-card__handle">{m.handle}</span>
                  )}
                </div>
                <div class="team-card__role">{m.role}</div>
                <p class="team-card__bio">{m.bio}</p>
                {m.socials && (
                  <div class="team-card__socials">
                    {m.socials.map((s) => (
                      <a
                        class="team-card__social"
                        href={s.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${m.name} · ${s.label}${t.opensNewTab}`}
                      >
                        <Icon name={s.icon} size={18} stroke={1.5} />
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
