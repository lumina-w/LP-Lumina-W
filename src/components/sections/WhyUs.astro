---
import Icon from '@/components/ui/Icon.astro';

const PORTFOLIO = 'https://wavival.dev/';

const reasons = [
  {
    n: '01',
    icon: 'shield',
    title: 'Seguridad desde la arquitectura.',
    description:
      'No es una capa que se agrega al final. Va en cada decisión técnica desde el día uno. Cada sistema que construimos está diseñado para resistir.',
  },
  {
    n: '02',
    icon: 'cpu',
    title: 'IA que automatiza procesos reales.',
    description:
      'No integramos IA como tendencia. La usamos donde genuinamente reduce trabajo, mejora decisiones y hace que tu operación sea más inteligente.',
  },
  {
    n: '03',
    icon: 'layers',
    title: 'Código limpio que escala.',
    description:
      'Sin deuda técnica desde el inicio. Lo que construimos hoy no lo reconstruyes en dos años. Documentado, mantenible y listo para crecer.',
  },
  {
    n: '04',
    icon: 'compass',
    title: 'Visión completa del producto.',
    description:
      'Diseño, frontend, backend, seguridad. Entendemos todo el sistema, no solo la parte que nos toca. Eso se nota en el resultado final.',
  },
];
---

<section class="section" id="us">
  <div class="container animate-on-scroll">
    <div class="s-head">
      <div>
        <div class="eyebrow">Por qué Lúmina W</div>
        <h2>El software que construimos no solo funciona hoy.</h2>
      </div>
      <p class="lead">
        Cuatro decisiones técnicas que sostenemos en cada proyecto. Sin
        matices, sin excepciones.
      </p>
      <div class="ghost-num" aria-hidden="true">06</div>
    </div>
    <div class="why">
      {
        reasons.map((r) => (
          <div class="why__item">
            <div class="why__num">{r.n}</div>
            <div class="why__head">
              <div class="why__icon">
                <Icon name={r.icon} size={28} stroke={1.5} />
              </div>
              <h3>{r.title}</h3>
            </div>
            <p>{r.description}</p>
          </div>
        ))
      }
    </div>
    <p class="why__more">
      <a
        class="service__cta"
        href={PORTFOLIO}
        target="_blank"
        rel="noopener noreferrer">Saber más</a
      >
    </p>
  </div>
</section>
