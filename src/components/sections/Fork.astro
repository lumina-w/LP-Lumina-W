---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(Astro.currentLocale).fork;
const paths = t.paths;
---

<section class="section fork-section" id="fork">
  <div class="animate-on-scroll container">
    <div class="s-head">
      <div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h2>{t.heading}</h2>
      </div>
      <p class="lead">
        {t.lead}
      </p>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>

    <div class="fork">
      {
        paths.map((p) => (
          <div class={`fork__card ${p.inverse ? 'fork__card--inverse' : ''}`}>
            <div class="fork__head">
              <div class="fork__tag">{p.tag}</div>
              <div class="fork__icon">
                <Icon name={p.icon} size={30} stroke={1.5} />
              </div>
            </div>
            <h3 class="fork__title">{p.title}</h3>
            <p class="fork__line">{p.line}</p>
            <a class="fork__cta" href={p.href}>
              {p.cta}
            </a>
          </div>
        ))
      }
    </div>

    <p class="fork__aside">
      {t.asidePre}
      <a class="fork__aside-link" href="/#contact">{t.asideLink}</a>
    </p>
  </div>
</section>
