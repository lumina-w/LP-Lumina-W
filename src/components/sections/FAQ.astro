---
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(Astro.currentLocale).faq;
const faqs = t.items;
---

<section class="section" id="faq" aria-labelledby="faq-heading">
  <div class="animate-on-scroll container">
    <div
      class="s-head"
      style="justify-items:center;grid-template-columns:1fr;margin-bottom:48px;text-align:center"
    >
      <div
        style="display:flex;flex-direction:column;align-items:center;gap:16px"
      >
        <div class="eyebrow">{t.eyebrow}</div>
        <h2 id="faq-heading" style="text-align:center;max-width:22ch">
          {t.heading}
        </h2>
        <p class="lead" style="text-align:center">
          {t.lead}
        </p>
      </div>
      <div class="ghost-num" aria-hidden="true">{t.ghost}</div>
    </div>

    <div class="faq" id="faq-list">
      {
        faqs.map((f, i) => (
          <div class={`faq__item ${i === 0 ? 'open' : ''}`} data-index={i}>
            <button
              type="button"
              id={`faq-q-${i}`}
              class="faq__q"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`faq-a-${i}`}
            >
              <span>{f.q}</span>
              <Icon name="plus" size={20} stroke={1.75} />
            </button>
            <div class="faq__a-wrap">
              <div
                id={`faq-a-${i}`}
                class="faq__a"
                role="region"
                aria-labelledby={`faq-q-${i}`}
              >
                {f.a}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div style="margin-top:48px;text-align:center">
      <p style="font-size:14px;color:var(--text-muted);margin-bottom:14px">
        {t.ctaKicker}
      </p>
      <a class="btn-primary" href="#contact">{t.cta}</a>
    </div>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://luminaw.co/#faq',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  })}
/>

<script>
  import '@/scripts/faq.ts';
</script>
