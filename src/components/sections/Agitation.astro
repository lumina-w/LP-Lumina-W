---
const points = [
  'Un sistema que falla en producción detiene tu operación.',
  'Uno que no escala te obliga a reconstruirlo en dos años.',
  'Uno sin seguridad expone los datos de tu empresa y tus clientes.',
];
---

<section class="stakes-band">
  <div class="container animate-on-scroll">
    <h2 class="stakes-band__h">
      El software mal construido<br />
      cuesta más que no tener software.
    </h2>
    <div class="stakes-band__list">
      {points.map((point) => <p>{point}</p>)}
    </div>
    <p class="stakes-band__tail">
      La mayoría de las empresas lo descubren tarde.
    </p>
  </div>
</section>
