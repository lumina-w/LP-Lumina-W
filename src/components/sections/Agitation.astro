---
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(Astro.currentLocale).agitation;
const points = t.points;
---

<section class="stakes-band">
  <div class="animate-on-scroll container">
    <h2 class="stakes-band__h">
      {t.headingA}<br />
      {t.headingB}
    </h2>
    <div class="stakes-band__list">
      {points.map((point) => <p>{point}</p>)}
    </div>
    <p class="stakes-band__tail">
      {t.tail}
    </p>
  </div>
</section>
